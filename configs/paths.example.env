# Copy this file to configs/paths.env or export these variables in your shell.
# Replace the placeholders with paths on your own machine or server.
# This file intentionally contains no credentials or machine-specific paths.

# Shared path contract: keep these placeholder names unchanged across scripts.
DATA_DIR=YOUR_DATA_DIR
MODEL_DIR=YOUR_MODEL_DIR
OUTPUT_DIR=YOUR_OUTPUT_DIR

# Training writes to: $OUTPUT_DIR/<ABLATION>/

# Optional alternative split filenames inside DATA_DIR:
# TRAIN_FILE=train_set.xlsx
# VAL_FILE=val_set.xlsx

